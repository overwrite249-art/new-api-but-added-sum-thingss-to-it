# ============================================================================
# New API - environment template for SERVERLESS (Vercel) deployments
# ============================================================================
#
# Copy these into Vercel > Project > Settings > Environment Variables.
# This is NOT a drop-in copy of .env.example: several upstream defaults are
# written for a single long-lived process and are wrong -- some of them
# actively harmful -- when the same code runs as N stateless instances.
#
# Every override below is annotated with WHY. Read them before changing.
# ============================================================================


# ---------------------------------------------------------------------------
# 1. REQUIRED: the two settings the bootstrap refuses to start without
# ---------------------------------------------------------------------------

# Load-bearing twice over. See serverless/bootstrap.go.
#   a) StartSystemTaskRunner, StartSubscriptionQuotaResetTask and
#      StartCodexCredentialAutoRefreshTask each begin with
#      `if !common.IsMasterNode { return }`. As a slave, those daemon loops
#      cannot start even by accident -- which is what we want, because a
#      function runtime freezes goroutines the moment a response is sent.
#      Their work is driven by /api/cron instead.
#   b) router.SetRouter only calls SetWebRouter (the sole consumer of the
#      embedded web/dist filesystem) when the node is master OR when
#      FRONTEND_BASE_URL is empty. Slave + FRONTEND_BASE_URL set means the
#      embed is never touched, so the Go function does not need the frontend
#      compiled into it.
NODE_TYPE=slave

# Must be non-empty (see (b) above). Set it to your canonical site URL.
FRONTEND_BASE_URL=https://your-project.vercel.app


# ---------------------------------------------------------------------------
# 2. REQUIRED: database
# ---------------------------------------------------------------------------

# SQLite is NOT usable. It is a single file on a local disk; serverless
# instances have an ephemeral, per-instance, mostly read-only filesystem, so
# each instance would get its own empty database that vanishes on recycle.
# Use managed Postgres (Neon, Supabase, RDS) or MySQL (PlanetScale, RDS).
SQL_DSN=postgres://user:password@host:5432/newapi?sslmode=require

# CRITICAL: upstream defaults to SQL_MAX_OPEN_CONNS=1000. That is sized for
# ONE process. Here the pool is per-instance, so the real ceiling is
# 1000 x (concurrent instances) and a modest traffic spike will exhaust the
# database's connection limit (managed Postgres is often capped near 100-500)
# and start refusing connections. Keep this small and, ideally, point SQL_DSN
# at a transaction-mode connection pooler (PgBouncer / Neon pooled endpoint /
# Supabase :6543) so the pooler -- not each instance -- owns fan-in.
SQL_MAX_OPEN_CONNS=3
SQL_MAX_IDLE_CONNS=1

# Recycle connections quickly. Instances are short-lived, and a pooler may
# drop server-side connections underneath a frozen instance; a long lifetime
# just means handing out dead connections after a thaw.
SQL_MAX_LIFETIME=30

# Optional: separate database for request logs. Same pooling caveats apply.
# LOG_SQL_DSN=


# ---------------------------------------------------------------------------
# 3. STRONGLY RECOMMENDED: Redis
# ---------------------------------------------------------------------------

# Without Redis, all caching and rate limiting is per-instance in-process
# memory. Consequences on serverless:
#   - rate limits are enforced per instance, so effective limits are silently
#     multiplied by the number of live instances (a real abuse vector);
#   - every cold start re-reads options/channels/pricing from the database,
#     making cold starts slower and noisier.
# Use a serverless-friendly Redis (Upstash) over TLS.
# REDIS_CONN_STRING=rediss://default:password@host:6379


# ---------------------------------------------------------------------------
# 4. REQUIRED: cron authentication
# ---------------------------------------------------------------------------

# /api/cron triggers expensive work (testing every channel, refreshing OAuth
# credentials, scanning subscriptions), so it fails CLOSED: if CRON_SECRET is
# unset, every request is rejected with 401 rather than defaulting to open.
# Vercel automatically sends this as `Authorization: Bearer $CRON_SECRET` on
# scheduled invocations. Generate with: openssl rand -hex 32
CRON_SECRET=replace-me-with-a-long-random-string


# ---------------------------------------------------------------------------
# 5. REQUIRED: session signing
# ---------------------------------------------------------------------------

# Upstream generates a random session secret at startup if unset. Across many
# instances that means each instance signs cookies with a DIFFERENT key, so
# dashboard logins break seemingly at random as requests land on different
# instances. It MUST be pinned to a fixed value here.
# Generate with: openssl rand -hex 32
SESSION_SECRET=replace-me-with-a-long-random-string

# Vercel serves HTTPS, so scope session cookies to secure transport.
SESSION_COOKIE_SECURE=true


# ---------------------------------------------------------------------------
# 6. MUST DISABLE: in-memory write buffers (silent data loss)
# ---------------------------------------------------------------------------

# Batch updating accumulates quota/usage deltas in process memory and flushes
# them on a timer (model.InitBatchUpdater). On serverless the flush timer is
# frozen with the instance and the instance is later discarded, so buffered
# billing data is lost outright. Disabling it makes those writes synchronous:
# more database round-trips, but correct accounting.
BATCH_UPDATE_ENABLED=false

# Same failure mode for dashboard aggregation: main.go only persists the
# in-memory quota cache via model.SaveQuotaDataCache() during graceful
# shutdown, and a function runtime has no graceful shutdown hook to run it.
# Leave data export off unless you accept gaps in dashboard statistics.
DATA_EXPORT_ENABLED=false


# ---------------------------------------------------------------------------
# 7. Caching and sync frequency
# ---------------------------------------------------------------------------

# Note: the serverless bootstrap deliberately does NOT start
# model.SyncChannelCache / model.SyncOptions / authz.StartPolicySync, because a
# frozen instance cannot refresh anything. Caches are rebuilt on each cold
# start instead. Practical effect: a warm instance can serve slightly stale
# configuration until it is recycled. With Redis configured this window is
# much smaller. SYNC_FREQUENCY is therefore mostly inert here.
MEMORY_CACHE_ENABLED=true
SYNC_FREQUENCY=60


# ---------------------------------------------------------------------------
# 8. Timeouts (must fit inside the platform function limit)
# ---------------------------------------------------------------------------

# A function is killed at maxDuration (vercel.json: 300s, which requires a Pro
# plan; Hobby is lower -- verify your plan's ceiling). Any relay timeout longer
# than that limit is unreachable: the platform kills the invocation first, and
# the client sees a truncated stream rather than New API's own error.
# Keep these strictly BELOW maxDuration.
RELAY_TIMEOUT=280
STREAMING_TIMEOUT=280


# ---------------------------------------------------------------------------
# 9. Must stay off
# ---------------------------------------------------------------------------

# pprof binds a second listener on 0.0.0.0:8005 and starts a monitor
# goroutine. A function runtime exposes exactly one HTTP entrypoint and
# freezes goroutines, so this cannot work and only slows cold starts.
ENABLE_PPROF=false

DEBUG=false
# GIN_MODE=debug   # uncomment only for temporary verbose local debugging


# ---------------------------------------------------------------------------
# 10. Proxy / client IP
# ---------------------------------------------------------------------------

# Requests always arrive via Vercel's edge, so the direct peer address is
# never the real client. Without trusting the proxy, IP-based rate limiting
# and abuse controls all see the same handful of edge addresses and collapse
# into a single bucket. Prefer the narrowest trusted set your setup allows.
TRUSTED_PROXIES=0.0.0.0/0


# ---------------------------------------------------------------------------
# 11. Optional passthrough settings (unchanged from .env.example)
# ---------------------------------------------------------------------------

# UPDATE_TASK=true                 # async task polling; driven by /api/cron here
# CHANNEL_UPDATE_FREQUENCY=30
# TLS_INSECURE_SKIP_VERIFY=false
# GENERATE_DEFAULT_TOKEN=false
# TRUSTED_REDIRECT_DOMAINS=
# GEMINI_VISION_MAX_IMAGE_NUM=16
# USER_SESSION_ACTIVE_LIMIT=50
# USER_SESSION_ISSUANCE_LIMIT=100

# Deliberately omitted: SQLITE_PATH (no persistent disk),
# SHUTDOWN_TIMEOUT_SECONDS (no graceful shutdown hook to honour it).
